# Copy this file to .env and fill in real values. Never commit .env.
APP_ENV=local
APP_DEBUG=true
APP_NAME=YTAN

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=ytan
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Generate a long random string, e.g.: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=change-me-to-a-random-secret
# 10 years - login should only end via manual logout, not by silently expiring
JWT_TTL_SECONDS=315360000

# Google Maps JavaScript API key (get a NEW key for YTAN, do not reuse PESR's)
MAPS_API_KEY=

# Comma-separated list of allowed CORS origins for the API, e.g. https://app.ytan.example,capacitor://localhost
ALLOWED_ORIGINS=*

# Comma-separated list of UI locales the app supports (resources/i18n/{locale}.json
# must exist for each) - first entry is the fallback when a visitor's stored
# preference/Accept-Language doesn't match any of them.
SUPPORTED_LOCALES=en,de

# Fully qualified base URL of this deployment (scheme+host+optional subdir,
# NO trailing slash), used to build absolute links in invite/reset emails
# since the per-request base path has no scheme/host of its own.
APP_URL=https://example.com/ytan/public

# Enables the /translate developer tool (comfortable editor for
# resources/i18n/{en,de}.json, admin-only). Off by default even with a
# valid admin login: this endpoint writes directly into the <script> tag
# every page injects translations into, so its blast radius is bigger
# than a typical admin action - only turn this on where you're actively
# doing a translation pass (e.g. locally), never leave it on in production.
TRANSLATE_TOOL_ENABLED=false

# SMTP settings used to send invite / password-reset emails.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.com
MAIL_ENCRYPTION=tls
