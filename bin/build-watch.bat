@echo off
REM Builds the YTAN waypoint data field (watch\) for ONE Garmin watch model,
REM for sideloading - not via the Connect IQ Store.
REM
REM   bin\build-watch.bat WATCH-KEY [DEVICE] [test]
REM
REM   WATCH-KEY  the key from YTAN: Profile, Garmin watch, Create watch key -
REM              the data field then fetches its route from the server itself
REM              (what the website/PWA sends) AND takes what the YTAN Android
REM              app sends it, without the app knowing the key;
REM              or the word app: a build WITHOUT a key, the same for every
REM              user and watch of that model - it only shows what the YTAN
REM              Android app sends it (while the data field is running);
REM              or a single dash to reuse the existing watch\source\Config.mc
REM              (key and server) from the previous build
REM   DEVICE     Connect IQ product id, default fenix7 (e.g. fenix6pro,
REM              fenix7pro, fenix7x - must be listed in watch\manifest.xml
REM              and installed via the Connect IQ SDK Manager)
REM   test       fetch routes from test.pesr.org instead of ytan.pesr.org
REM
REM Result: watch\bin\ytan-DEVICE.prg - connect the watch by USB and copy it
REM into the watch's GARMIN\Apps folder.
REM
REM Needs the Connect IQ SDK (install via Garmin's SDK Manager, which
REM records the active SDK in %APPDATA%\Garmin\ConnectIQ\current-sdk.cfg)
REM and a developer key (generated with openssl on first run if missing).
REM The watch key ends up in the gitignored watch\source\Config.mc.
REM
REM NOTE: never put an unescaped less-than, greater-than or pipe character
REM in a REM line of this file - cmd.exe parses them even in comments.

setlocal

for %%I in ("%~dp0..") do set "ROOT_DIR=%%~fI"

set "WATCH_KEY=%~1"
set "DEVICE=%~2"
if "%DEVICE%"=="" set "DEVICE=fenix7"
set "SERVER_URL=https://ytan.pesr.org"
if /i "%~3"=="test" set "SERVER_URL=https://test.pesr.org"

if "%WATCH_KEY%"=="" (
    echo ==^> Usage: bin\build-watch.bat WATCH-KEY [DEVICE] [test]
    echo      Create the watch key in YTAN: Profile, Garmin watch -
    echo      or pass the word app for a build without a key ^(the YTAN
    echo      Android app then sends the route^).
    goto :error
)

if not defined CIQ_SDK_HOME (
    if exist "%APPDATA%\Garmin\ConnectIQ\current-sdk.cfg" (
        set /p CIQ_SDK_HOME=<"%APPDATA%\Garmin\ConnectIQ\current-sdk.cfg"
    )
)
if not defined CIQ_SDK_HOME (
    echo ==^> Connect IQ SDK not found. Install it with Garmin's SDK Manager
    echo      ^(developer.garmin.com/connect-iq/sdk^), including the device
    echo      %DEVICE%, or set CIQ_SDK_HOME to the SDK folder.
    goto :error
)
REM current-sdk.cfg may end with a trailing backslash.
if "%CIQ_SDK_HOME:~-1%"=="\" set "CIQ_SDK_HOME=%CIQ_SDK_HOME:~0,-1%"
if not exist "%CIQ_SDK_HOME%\bin\monkeyc.bat" (
    echo ==^> %CIQ_SDK_HOME%\bin\monkeyc.bat not found - check CIQ_SDK_HOME.
    goto :error
)

if not defined ANDROID_BUILD_JDK_HOME set "ANDROID_BUILD_JDK_HOME=C:\Program Files\Eclipse Adoptium\jdk-21.0.12.101-hotspot"
if exist "%ANDROID_BUILD_JDK_HOME%\bin\java.exe" (
    set "JAVA_HOME=%ANDROID_BUILD_JDK_HOME%"
    set "PATH=%ANDROID_BUILD_JDK_HOME%\bin;%PATH%"
)

REM VS Code's "Monkey C: Generate a Developer Key" names the (DER) file
REM developer_key without an extension - accept that too.
if not defined GARMIN_DEVELOPER_KEY (
    if exist "%USERPROFILE%\.garmin\developer_key" (
        set "GARMIN_DEVELOPER_KEY=%USERPROFILE%\.garmin\developer_key"
    ) else (
        set "GARMIN_DEVELOPER_KEY=%USERPROFILE%\.garmin\developer_key.der"
    )
)
if not exist "%GARMIN_DEVELOPER_KEY%" (
    echo ==^> Creating developer key %GARMIN_DEVELOPER_KEY%
    set "OPENSSL=openssl"
    where openssl 1>nul 2>nul || set "OPENSSL=C:\Program Files\Git\mingw64\bin\openssl.exe"
    if not exist "%USERPROFILE%\.garmin" mkdir "%USERPROFILE%\.garmin"
    call :make_key
    if not exist "%GARMIN_DEVELOPER_KEY%" goto :error
)

if "%WATCH_KEY%"=="-" (
    if not exist "%ROOT_DIR%\watch\source\Config.mc" (
        echo ==^> No watch\source\Config.mc from a previous build - pass the watch key.
        goto :error
    )
    echo ==^> Reusing watch\source\Config.mc from the previous build
    goto :build
)

REM "app" = no key at all (see the header): the empty token tells the data
REM field not to fetch from the server.
set "TOKEN_VALUE=%WATCH_KEY%"
if /i "%WATCH_KEY%"=="app" set "TOKEN_VALUE="
if defined TOKEN_VALUE (
    echo ==^> Writing watch\source\Config.mc ^(server %SERVER_URL%, with watch key^)
) else (
    echo ==^> Writing watch\source\Config.mc ^(no watch key: the YTAN app sends the route^)
)
(
    echo // Generated by bin\build-watch.bat - do not commit ^(contains your watch key^).
    echo ^(:background^)
    echo module YtanConfig {
    echo     const SERVER_URL = "%SERVER_URL%";
    echo     const WATCH_TOKEN = "%TOKEN_VALUE%";
    echo }
) > "%ROOT_DIR%\watch\source\Config.mc"

:build
if not exist "%ROOT_DIR%\watch\bin" mkdir "%ROOT_DIR%\watch\bin"
set "PRG=%ROOT_DIR%\watch\bin\ytan-%DEVICE%.prg"

REM -r: release build (no debug info, optimized) - this is what goes on
REM the watch. bin\sim-watch.bat builds the debug/simulator variant.
echo ==^> Building release %PRG%
call "%CIQ_SDK_HOME%\bin\monkeyc.bat" -f "%ROOT_DIR%\watch\monkey.jungle" -d %DEVICE% -o "%PRG%" -y "%GARMIN_DEVELOPER_KEY%" -r -w
if errorlevel 1 goto :error

echo.
echo ==^> Built %PRG%
echo      Connect the watch by USB and copy the file into GARMIN\Apps.
echo      Then add the data field "YTAN" to an activity profile, e.g. Kayak.
endlocal
exit /b 0

:make_key
REM The PEM is only an intermediate step - written to TEMP and removed.
set "KEY_PEM=%TEMP%\ytan-developer-key-%RANDOM%.pem"
"%OPENSSL%" genrsa -out "%KEY_PEM%" 4096
"%OPENSSL%" pkcs8 -topk8 -inform PEM -outform DER -in "%KEY_PEM%" -out "%GARMIN_DEVELOPER_KEY%" -nocrypt
del /q "%KEY_PEM%" 2>nul
exit /b 0

:error
echo ==^> Watch build FAILED.
endlocal
exit /b 1
