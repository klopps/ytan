{
    "name": "klopps/ytan",
    "description": "YTAN - Kayak touring planner (web API + web app)",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "firebase/php-jwt": "^6.10",
        "meyfa/php-svg": "^0.13",
        "phpmailer/phpmailer": "^7.1",
        "slim/psr7": "^1.6",
        "slim/slim": "^4.12",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Ytan\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ytan\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "test-db": "php bin/setup-test-db.php",
        "post-install-cmd": "@php bin/configure-git-hooks.php",
        "post-update-cmd": "@php bin/configure-git-hooks.php"
    }
}
