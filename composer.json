{
    "name": "klopps/ytan",
    "description": "YTAN - Kayak touring planner (web API + web app)",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "slim/slim": "^4.12",
        "slim/psr7": "^1.6",
        "firebase/php-jwt": "^6.10",
        "vlucas/phpdotenv": "^5.6",
        "meyfa/php-svg": "^0.13"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Ytan\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ytan\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
