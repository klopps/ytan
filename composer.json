{
    "name": "klopps/ytan",
    "description": "YTAN - Kayak touring planner (web API + web app)",
    "type": "project",
    "version": "1.0.0",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "anthropic-ai/sdk": "^1.8",
        "dompdf/dompdf": "^3.1",
        "firebase/php-jwt": "^7.2",
        "guzzlehttp/guzzle": "^7.9",
        "league/commonmark": "^2.4",
        "meyfa/php-svg": "^0.13",
        "phpmailer/phpmailer": "^7.1",
        "slim/psr7": "^1.6",
        "slim/slim": "^4.12",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "smalot/pdfparser": "^2.13"
    },
    "autoload": {
        "psr-4": {
            "Ytan\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ytan\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        },
        "allow-plugins": {
            "php-http/discovery": false
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-db": "php bin/setup-test-db.php",
        "post-install-cmd": "@php bin/configure-git-hooks.php",
        "post-update-cmd": "@php bin/configure-git-hooks.php"
    }
}
