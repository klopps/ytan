# Configuration of the YTAN worker container. Copy to ~/ytan-worker/worker.env on the worker machine
# (it holds a secret: never commit it, bin\publish-worker.bat never overwrites it).

# The server's SSH user/host and the absolute path of its storage/ directory (only used to print the
# authorized_keys line). The worker connects TO the server; the server never connects to the worker.
YTAN_SERVER_HOST=steindorff.de
YTAN_SERVER_USER=csteindorff
YTAN_SERVER_STORAGE=/home/www/doc/9769/ytan.pesr.org/www/storage

# This worker's unique name, created in Admin > Workers (a-z, 0-9, -; at most 32 characters).
WORKER_ID=ytanworker
# What this system can do, comma separated (radar,wind); empty = every job. Leave out a job this machine
# is too small for.
WORKER_JOBS=
# Shown in Admin > Workers (display only). WORKER_HOST_NAME is the host name in the report: without it the
# container's id (it changes with every rebuild) is shown.
WORKER_ADDRESS=192.168.178.12
WORKER_HOST_NAME=ytanworker
# Threads/processes per job (the server's setting is replaced by this one) and the minutes between ticks.
WORKER_THREADS=2
TICK_MINUTES=5

# Météo-France AROME API key (wind job); empty = the job goes on without AROME.
AROME_API_KEY=

# Optional: time zone of the log time stamps, memory limit of the container (a 4 GB machine: 3g).
TZ=Europe/Berlin
WORKER_MEM_LIMIT=3g
