# Android app download (bin\publish-app.bat uploads public/app/ytan.apk):
# without the proper type, Apache serves it as a generic binary and Chrome
# on Android may not offer to install it.
AddType application/vnd.android.package-archive .apk

# version.json drives the in-app update check (native-app.js) - must never
# be served stale from an HTTP cache.
<IfModule mod_headers.c>
    <FilesMatch "^version\.json$">
        Header set Cache-Control "no-cache"
    </FilesMatch>

    # Security headers (security audit 2026-10-16), for PHP responses and
    # static files alike: no MIME sniffing, no framing by other sites (the
    # help page's iframe is same-origin), no full URLs as Referer to other
    # sites (Google's referrer-restricted Maps key only needs the origin),
    # and HSTS - only on an HTTPS request, so plain-HTTP dev setups
    # (localhost, LAN IP, watch simulator) are unaffected. The
    # Content-Security-Policy is NOT set here: it carries a per-request
    # nonce and comes from PHP (src/Http/ContentSecurityPolicy.php) - a
    # "Header set" here would replace it.
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Strict-Transport-Security "max-age=15552000" env=HTTPS

    # Browser caching (performance review 2026-10-16). Scripts/styles/
    # fonts/images that the templates request with ?v=<mtime>
    # (App::assetVersion()) get a new URL whenever they change, so they may
    # be cached for a year without asking again (YTAN_VERSIONED is set by
    # the RewriteRule below). Unversioned images/fonts (markers, help
    # screenshots, fonts referenced from fonts.css) for a day. Without this
    # the browser revalidated every file on every visit.
    Header set Cache-Control "public, max-age=31536000, immutable" env=YTAN_VERSIONED
    <FilesMatch "\.(png|jpe?g|webp|gif|svg|ico|woff2?|ttf|otf)$">
        Header set Cache-Control "public, max-age=86400" env=!YTAN_VERSIONED
    </FilesMatch>
</IfModule>

# gzip for static text files (PHP responses are compressed by
# CompressionMiddleware; mod_deflate leaves those alone). Both modules are
# optional - without them nothing breaks, files just stay uncompressed.
<IfModule mod_deflate.c>
    <IfModule mod_filter.c>
        AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/javascript application/javascript application/json application/xml application/manifest+json image/svg+xml
    </IfModule>
</IfModule>

RewriteEngine On

# Versioned static asset (?v=..., see the Cache-Control block above).
RewriteCond %{QUERY_STRING} (^|&)v=
RewriteRule \.(js|css|png|jpe?g|webp|gif|svg|ico|woff2?|ttf|otf)$ - [E=YTAN_VERSIONED:1]

# Plain HTTP -> HTTPS on real hosts. A bearer token sent over HTTP could be
# read on the way. Left out: localhost, private/LAN IPs, IPv6 literals and
# hostnames without a dot (dev setups, e.g. testing from a phone via the LAN
# IP or the Garmin simulator, which needs plain HTTP).
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteCond %{HTTP_HOST} \.
RewriteCond %{HTTP_HOST} !^(localhost|127\.|10\.|192\.168\.|172\.(1[6-9]|2[0-9]|3[01])\.|\[) [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# If the request maps to a real file or directory (css/js/images/...), serve it directly.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Everything else goes through the front controller.
RewriteRule ^ index.php [QSA,L]
