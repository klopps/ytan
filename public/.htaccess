# Android app download (bin\publish-app.bat uploads public/app/ytan.apk):
# without the proper type, Apache serves it as a generic binary and Chrome
# on Android may not offer to install it.
AddType application/vnd.android.package-archive .apk

# version.json drives the in-app update check (native-app.js) - must never
# be served stale from an HTTP cache.
<IfModule mod_headers.c>
    <FilesMatch "^version\.json$">
        Header set Cache-Control "no-cache"
    </FilesMatch>

    # Security headers (security audit 2026-10-16), for PHP responses and
    # static files alike: no MIME sniffing, no framing by other sites (the
    # help page's iframe is same-origin), no full URLs as Referer to other
    # sites (Google's referrer-restricted Maps key only needs the origin),
    # and HSTS - only on an HTTPS request, so plain-HTTP dev setups
    # (localhost, LAN IP, watch simulator) are unaffected. A full
    # Content-Security-Policy is still open (todo.md): the app relies on
    # inline scripts and onclick attributes.
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Content-Security-Policy "frame-ancestors 'self'"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Strict-Transport-Security "max-age=15552000" env=HTTPS
</IfModule>

RewriteEngine On

# Plain HTTP -> HTTPS on real hosts. A bearer token sent over HTTP could be
# read on the way. Left out: localhost, private/LAN IPs, IPv6 literals and
# hostnames without a dot (dev setups, e.g. testing from a phone via the LAN
# IP or the Garmin simulator, which needs plain HTTP).
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteCond %{HTTP_HOST} \.
RewriteCond %{HTTP_HOST} !^(localhost|127\.|10\.|192\.168\.|172\.(1[6-9]|2[0-9]|3[01])\.|\[) [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# If the request maps to a real file or directory (css/js/images/...), serve it directly.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Everything else goes through the front controller.
RewriteRule ^ index.php [QSA,L]
