{
  "comment": "Test vectors of the worker election - read by tests/Unit/WorkerElectionTest.php (JobPlacement::activeWorker) AND tools/tests/test_worker.py (ytan_jobs.active_worker): both implementations must give the same answer. A worker's 'age' is how many seconds ago its heartbeat 'tick' was written; 'running' is the job it reports to be working on; 'server_age' the age of storage/jobs-heartbeat.json (null = there is none). Stale limits: 900 s, 7200 s while running.",
  "now": 1800000000,
  "cases": [
    {"name": "the first enabled, alive and able entry wins", "job": "wind",
     "list": [{"id": "a", "enabled": true}, {"id": "b", "enabled": true}],
     "workers": {"a": {"age": 60, "capabilities": ["wind"]}, "b": {"age": 10, "capabilities": ["wind"]}},
     "server_age": null, "expected": "a"},
    {"name": "a silent first entry hands over to the next", "job": "wind",
     "list": [{"id": "a", "enabled": true}, {"id": "b", "enabled": true}],
     "workers": {"a": {"age": 3600, "capabilities": ["wind"]}, "b": {"age": 10, "capabilities": ["wind"]}},
     "server_age": null, "expected": "b"},
    {"name": "a worker that does not report the job is skipped", "job": "wind",
     "list": [{"id": "a", "enabled": true}, {"id": "b", "enabled": true}],
     "workers": {"a": {"age": 60, "capabilities": ["radar"]}, "b": {"age": 10, "capabilities": ["radar", "wind"]}},
     "server_age": null, "expected": "b"},
    {"name": "a worker without capabilities is skipped", "job": "wind",
     "list": [{"id": "a", "enabled": true}, {"id": "b", "enabled": true}],
     "workers": {"a": {"age": 60}, "b": {"age": 10, "capabilities": ["wind"]}},
     "server_age": null, "expected": "b"},
    {"name": "a disabled entry does not count", "job": "wind",
     "list": [{"id": "a", "enabled": false}, {"id": "b", "enabled": true}],
     "workers": {"a": {"age": 5, "capabilities": ["wind"]}, "b": {"age": 10, "capabilities": ["wind"]}},
     "server_age": null, "expected": "b"},
    {"name": "all workers away: the server is the stand-in when it is listed and its cron ticks", "job": "wind",
     "list": [{"id": "a", "enabled": true}, {"id": "server", "enabled": true}],
     "workers": {"a": {"age": 3600, "capabilities": ["wind"]}},
     "server_age": 60, "expected": "server"},
    {"name": "all workers away and the server not listed: nobody", "job": "wind",
     "list": [{"id": "a", "enabled": true}, {"id": "server", "enabled": false}],
     "workers": {"a": {"age": 3600, "capabilities": ["wind"]}},
     "server_age": 60, "expected": null},
    {"name": "the server first wins over a later worker", "job": "radar",
     "list": [{"id": "server", "enabled": true}, {"id": "a", "enabled": true}],
     "workers": {"a": {"age": 10, "capabilities": ["radar"]}},
     "server_age": 30, "expected": "server"},
    {"name": "the server's cron is dead: the next worker takes the job", "job": "radar",
     "list": [{"id": "server", "enabled": true}, {"id": "a", "enabled": true}],
     "workers": {"a": {"age": 10, "capabilities": ["radar"]}},
     "server_age": 3600, "expected": "a"},
    {"name": "no server heartbeat at all: the server does not count", "job": "radar",
     "list": [{"id": "server", "enabled": true}, {"id": "a", "enabled": true}],
     "workers": {"a": {"age": 10, "capabilities": ["radar"]}},
     "server_age": null, "expected": "a"},
    {"name": "a worker that is running the job keeps it when a higher one returns", "job": "wind",
     "list": [{"id": "a", "enabled": true}, {"id": "b", "enabled": true}],
     "workers": {"a": {"age": 5, "capabilities": ["wind"]}, "b": {"age": 100, "capabilities": ["wind"], "running": "wind"}},
     "server_age": null, "expected": "b"},
    {"name": "running another job holds nothing", "job": "wind",
     "list": [{"id": "a", "enabled": true}, {"id": "b", "enabled": true}],
     "workers": {"a": {"age": 5, "capabilities": ["wind"]}, "b": {"age": 100, "capabilities": ["wind", "radar"], "running": "radar"}},
     "server_age": null, "expected": "a"},
    {"name": "a long run: a heartbeat of one hour is still alive while running", "job": "wind",
     "list": [{"id": "a", "enabled": true}, {"id": "b", "enabled": true}],
     "workers": {"a": {"age": 3600, "capabilities": ["wind"], "running": "wind"}, "b": {"age": 10, "capabilities": ["wind"]}},
     "server_age": null, "expected": "a"},
    {"name": "a running worker silent for more than two hours is away", "job": "wind",
     "list": [{"id": "a", "enabled": true}, {"id": "b", "enabled": true}],
     "workers": {"a": {"age": 7201, "capabilities": ["wind"], "running": "wind"}, "b": {"age": 10, "capabilities": ["wind"]}},
     "server_age": null, "expected": "b"},
    {"name": "an entry that never reported is skipped", "job": "wind",
     "list": [{"id": "ghost", "enabled": true}, {"id": "b", "enabled": true}],
     "workers": {"b": {"age": 10, "capabilities": ["wind"]}},
     "server_age": null, "expected": "b"},
    {"name": "the stale limit: 900 s is alive", "job": "wind",
     "list": [{"id": "a", "enabled": true}, {"id": "b", "enabled": true}],
     "workers": {"a": {"age": 900, "capabilities": ["wind"]}, "b": {"age": 10, "capabilities": ["wind"]}},
     "server_age": null, "expected": "a"},
    {"name": "the stale limit: 901 s is away", "job": "wind",
     "list": [{"id": "a", "enabled": true}, {"id": "b", "enabled": true}],
     "workers": {"a": {"age": 901, "capabilities": ["wind"]}, "b": {"age": 10, "capabilities": ["wind"]}},
     "server_age": null, "expected": "b"},
    {"name": "two running the job: the first in list order keeps it", "job": "wind",
     "list": [{"id": "a", "enabled": true}, {"id": "b", "enabled": true}],
     "workers": {"a": {"age": 5, "capabilities": ["wind"], "running": "wind"}, "b": {"age": 5, "capabilities": ["wind"], "running": "wind"}},
     "server_age": null, "expected": "a"},
    {"name": "everything disabled: nobody", "job": "wind",
     "list": [{"id": "a", "enabled": false}, {"id": "server", "enabled": false}],
     "workers": {"a": {"age": 5, "capabilities": ["wind"]}},
     "server_age": 5, "expected": null},
    {"name": "an empty list: nobody", "job": "wind",
     "list": [],
     "workers": {"a": {"age": 5, "capabilities": ["wind"]}},
     "server_age": 5, "expected": null}
  ]
}
